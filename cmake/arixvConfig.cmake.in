@PACKAGE_INIT@

# Only static installed packages require CXX in pure-C consumers so CMake
# propagates the C++ runtime linkage for ARIX-V's internal C++17 implementation.
# Shared packages link the C++ runtime inside libarixv and expose a pure C ABI.
if(NOT @ARIXV_INSTALLED_SHARED@ AND NOT CMAKE_CXX_COMPILER_LOADED)
  enable_language(CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/arixvTargets.cmake")

set(arixv_decoder_FOUND TRUE)
if(@ARIXV_INSTALLED_ENCODER@)
  set(arixv_encoder_FOUND TRUE)
else()
  set(arixv_encoder_FOUND FALSE)
endif()

check_required_components(arixv)
